{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicted_recovery",
    "evidence",
    "updates",
    "limitations",
    "design"
  ],
  "properties": {
    "predicted_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "c"
      ],
      "properties": {
        "a": {
          "type": "number"
        },
        "c": {
          "type": "number"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a_recovery_18h",
        "a_deficit_18h",
        "c_recovery_18h",
        "c_deficit_18h",
        "control_relative_iodine_loss",
        "chelated_relative_iodine_loss"
      ],
      "properties": {
        "a_recovery_18h": {
          "type": "number"
        },
        "a_deficit_18h": {
          "type": "number"
        },
        "c_recovery_18h": {
          "type": "number"
        },
        "c_deficit_18h": {
          "type": "number"
        },
        "control_relative_iodine_loss": {
          "type": "number"
        },
        "chelated_relative_iodine_loss": {
          "type": "number"
        }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_gain_supports_late_recovery",
        "matched_xps_difference_proves_causation",
        "null_xps_excludes_iodine_change",
        "no_late_gain_proves_permanence"
      ],
      "properties": {
        "resolved_gain_supports_late_recovery": {
          "type": "boolean"
        },
        "matched_xps_difference_proves_causation": {
          "type": "boolean"
        },
        "null_xps_excludes_iodine_change": {
          "type": "boolean"
        },
        "no_late_gain_proves_permanence": {
          "type": "boolean"
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_specimen_attribution",
        "permanent_loss_established"
      ],
      "properties": {
        "cross_specimen_attribution": {
          "type": "boolean"
        },
        "permanent_loss_established": {
          "type": "boolean"
        }
      }
    },
    "design": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "bias_v",
          "power_times",
          "xps_hour"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "bias_v": {
            "enum": [
              -2.7,
              0
            ]
          },
          "power_times": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "anyOf": [
                {
                  "const": "baseline"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 48
                }
              ]
            }
          },
          "xps_hour": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 48
          }
        }
      }
    }
  }
}
